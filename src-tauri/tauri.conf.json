{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsAppLite",
  "version": "1.0.0",
  "identifier": "com.levi.raniere.whatsapp-lite",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "WhatsAppLite",
        "label": "main",
        "width": 1100,
        "height": 720,
        "minWidth": 780,
        "minHeight": 480,
        "center": true,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false,
        "url": "https://web.whatsapp.com"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
